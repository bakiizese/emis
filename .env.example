# Copy to .env and fill in the secrets: cp .env.example .env
# Never commit .env.

NODE_ENV=development

# --- Ports (Postgres/Valkey use 5433/6380 so they never clash with a local install) --
API_PORT=4000
# web (public site) runs on 3000, portal on 3001

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=emis
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=emis
POSTGRES_PORT=5433
DATABASE_URL=postgres://emis:change-me-local-only@localhost:5433/emis

# --- Valkey (sessions, queues, rate limits) ----------------------------
VALKEY_PASSWORD=change-me-local-only
VALKEY_PORT=6380
VALKEY_URL=redis://:change-me-local-only@localhost:6380

# --- S3-compatible object storage --------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=emis
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- PDF rendering -----------------------------------------------------
GOTENBERG_URL=http://localhost:3100
GOTENBERG_PORT=3100

# --- Email (Mailpit in development) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Copy to .env and fill in the secrets: cp .env.example .env
# Never commit .env.

NODE_ENV=development

# --- API ---------------------------------------------------------------
# web (public site) runs on 3000, portal on 3001.
# Postgres/Valkey use 5433/6380 so they never clash with a local install.
API_PORT=4000
LOG_LEVEL=info
# true when running behind Caddy or a load balancer
TRUST_PROXY=false
# Comma-separated browser origins allowed cross-origin. Empty = same-origin only.
CORS_ORIGINS=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Interactive docs at /api/docs (off by default when NODE_ENV=production)
API_DOCS_ENABLED=true

# --- Auth & security ----------------------------------------------------
# Shown in authenticator apps and emails.
APP_NAME=EMIS
# Public frontend URLs: email links point here, and they're trusted for CSRF checks.
PORTAL_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Where the Next.js apps reach the API from the server (and where /api is proxied to in dev).
API_INTERNAL_URL=http://localhost:4000
# Set to true on the website and portal to make the Content-Security-Policy report violations in the
# browser console instead of blocking them (for diagnosing a page that misbehaves). Leave unset normally.
# CSP_REPORT_ONLY=true
# Encrypts secrets at rest (TOTP seeds). Generate with: openssl rand -base64 32
# When rotating, move the old key to ENCRYPTION_KEYS_PREVIOUS (comma-separated).
ENCRYPTION_KEY=
ENCRYPTION_KEYS_PREVIOUS=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Email (Mailpit catches everything in dev: http://localhost:8025) ---
MAIL_FROM=EMIS <no-reply@localhost>

# --- PostgreSQL --------------------------------------------------------
# Superuser: only used by `pnpm db:bootstrap` to create the three roles below.
POSTGRES_ADMIN_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
DATABASE_ADMIN_URL=postgres://postgres:change-me-local-only@localhost:5433/postgres
# Owns the schema and runs migrations (DDL).
DATABASE_MIGRATOR_URL=postgres://emis_migrator:change-me-migrator@localhost:5433/emis
# API and worker: read/write rows only, no schema changes.
DATABASE_URL=postgres://emis_app:change-me-app@localhost:5433/emis
# Reporting: read-only.
DATABASE_READONLY_URL=postgres://emis_readonly:change-me-readonly@localhost:5433/emis

# --- Valkey (job queues, used by the worker) ---------------------------
VALKEY_PASSWORD=change-me-local-only
VALKEY_PORT=6380
VALKEY_URL=redis://:change-me-local-only@localhost:6380

# --- S3-compatible object storage --------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=emis
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- PDF rendering -----------------------------------------------------
GOTENBERG_URL=http://localhost:3100
GOTENBERG_PORT=3100

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025

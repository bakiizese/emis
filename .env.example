# Copy to .env and fill in the secrets: cp .env.example .env
# Never commit .env.

NODE_ENV=development

# --- API ---------------------------------------------------------------
# web (public site) runs on 3000, portal on 3001.
# Postgres/Valkey use 5433/6380 so they never clash with a local install.
API_PORT=4000
LOG_LEVEL=info
# true when running behind Caddy or a load balancer
TRUST_PROXY=false
# Comma-separated browser origins allowed cross-origin. Empty = same-origin only.
CORS_ORIGINS=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Interactive docs at /api/docs (off by default when NODE_ENV=production)
API_DOCS_ENABLED=true

# --- PostgreSQL --------------------------------------------------------
# Superuser: only used by `pnpm db:bootstrap` to create the three roles below.
POSTGRES_ADMIN_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
DATABASE_ADMIN_URL=postgres://postgres:change-me-local-only@localhost:5433/postgres
# Owns the schema and runs migrations (DDL).
DATABASE_MIGRATOR_URL=postgres://emis_migrator:change-me-migrator@localhost:5433/emis
# API and worker: read/write rows only, no schema changes.
DATABASE_URL=postgres://emis_app:change-me-app@localhost:5433/emis
# Reporting: read-only.
DATABASE_READONLY_URL=postgres://emis_readonly:change-me-readonly@localhost:5433/emis

# --- Valkey (sessions, queues, rate limits) ----------------------------
VALKEY_PASSWORD=change-me-local-only
VALKEY_PORT=6380
VALKEY_URL=redis://:change-me-local-only@localhost:6380

# --- S3-compatible object storage --------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=emis
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- PDF rendering -----------------------------------------------------
GOTENBERG_URL=http://localhost:3100
GOTENBERG_PORT=3100

# --- Email (Mailpit in development) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

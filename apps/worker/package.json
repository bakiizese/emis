{
  "name": "@emis/worker",
  "version": "0.0.0",
  "private": true,
  "description": "EMIS background worker — outbox relay and BullMQ job processors (added in feat/p1-idempotency-outbox)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@emis/config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.13.6",
    "typescript": "~6.0.3"
  }
}

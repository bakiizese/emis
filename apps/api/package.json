{
  "name": "@emis/api",
  "version": "0.0.0",
  "private": true,
  "description": "EMIS backend engine — NestJS modular monolith (HTTP API)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@emis/contracts": "workspace:*",
    "@emis/db": "workspace:*",
    "@fastify/helmet": "^13.1.1",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@emis/config": "workspace:*",
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}

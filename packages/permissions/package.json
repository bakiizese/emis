{
  "name": "@emis/permissions",
  "version": "0.0.0",
  "private": true,
  "description": "Permission catalog, system roles and the scope-aware permission check shared by the API and the portal",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emis/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}

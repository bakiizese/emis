{
  "name": "@emis/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas shared by the API and the frontends — the single source of truth for API shapes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@emis/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}

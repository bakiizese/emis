{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "EMIS React source package (compiled by the consuming Next.js app)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "EMIS Node service (NestJS, ESM)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "types": ["node"]
  }
}

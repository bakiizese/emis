# Settings for the production stack (compose.prod.yml). Copy to `.env` next to it and fill in.
# Keep that file private: it holds every secret. Never commit it.
#
# Make each secret with:   openssl rand -hex 24
# (hex only: these go inside connection URLs, so no characters like @ or / please)

# --- Where people reach it -----------------------------------------------------------------------
# Full addresses. Two names pointing at this server; Caddy fetches HTTPS certificates for them.
WEB_URL=https://www.example.et
PORTAL_URL=https://portal.example.et
# What the sign-in codes and emails call the system.
APP_NAME=EMIS

# --- Which version to run ------------------------------------------------------------------------
# Images are published by the "Images" workflow. Pin a release tag (v1.0.0) or a commit sha.
EMIS_IMAGE_PREFIX=ghcr.io/bakiizese/emis
EMIS_TAG=latest

# --- Secrets -------------------------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=
EMIS_DB_MIGRATOR_PASSWORD=
EMIS_DB_APP_PASSWORD=
EMIS_DB_READONLY_PASSWORD=
VALKEY_PASSWORD=
# Encrypts secrets stored in the database (two-factor seeds). Make with: openssl rand -base64 32
# LOSE THIS AND THOSE SECRETS CANNOT BE READ. Keep a copy somewhere safe, apart from the server.
# To rotate: put the new key here and move the old one to ENCRYPTION_KEYS_PREVIOUS (comma-separated).
ENCRYPTION_KEY=
ENCRYPTION_KEYS_PREVIOUS=

# --- Email (invitations, password resets, receipts, fee reminders) ---------------------------------
# Any SMTP provider. 587 with SMTP_SECURE=false uses STARTTLS; 465 with SMTP_SECURE=true is TLS from the start.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Example Institute <no-reply@example.et>"

# --- Optional ------------------------------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL=info
# Ports Caddy listens on (change only to test on a machine where 80/443 are taken).
# HTTP_PORT=80
# HTTPS_PORT=443
# Set to true to make the security policy only report in the browser console instead of blocking.
# CSP_REPORT_ONLY=

# Where the encrypted backups are copied to. Copy to `offsite.env` next to compose.prod.yml and fill in.
# Only encrypted files ever go there, so a normal cloud bucket is fine. Use storage that is NOT on this server
# (a different provider or at least a different machine): a backup on the same disk dies with the disk.
#
# The destination is an "rclone" remote called offsite. Example: any S3-compatible storage
# (Backblaze B2, Wasabi, Cloudflare R2, MinIO, AWS S3...):
OFFSITE_PATH=my-bucket/emis
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
#
# For SFTP to another machine instead:
#   OFFSITE_PATH=/home/backup/emis
#   RCLONE_CONFIG_OFFSITE_TYPE=sftp
#   RCLONE_CONFIG_OFFSITE_HOST=backup.example.et
#   RCLONE_CONFIG_OFFSITE_USER=backup
#   RCLONE_CONFIG_OFFSITE_KEY_FILE=...        (or a password obscured with `rclone obscure`)
# Other providers (Google Drive, Dropbox, Azure...): https://rclone.org/docs/
#
# Old backups are not deleted offsite by the system. Set a lifecycle rule on the bucket (for example
# "delete after 90 days") so storage doesn't grow forever.
